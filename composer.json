{
  "name": "yourname/project",
  "description": "A basic PHP project",
  "type": "project",
  "require": {
    "php": ">=8.0"
  },
  "autoload": {
    "psr-4": {
      "App\\": "app/"
    }
  },
  "require-dev": {
    "pestphp/pest": "^2.36",
    "mockery/mockery": "^1.6",
    "phpunit/php-code-coverage": "^10.1",
    "pestphp/pest-plugin": "^2.1"
  },
  "scripts": {
    "test": "vendor/bin/pest"
  },
  "config": {
    "optimize-autoloader": true,
    "allow-plugins": {
      "pestphp/pest-plugin": true
    }
  },
  "minimum-stability": "stable"
}
